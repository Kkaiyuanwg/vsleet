+function collectErrors(raw, formatted) {
+    const out = [];
+    const push = (v) => { if (v && out.indexOf(v) < 0) { out.push(String(v)); } };
+    if (raw && (raw.full_compile_error || raw.full_runtime_error || raw.compile_error || raw.runtime_error)) {
